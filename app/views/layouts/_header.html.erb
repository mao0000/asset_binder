<header class="bg-white border-b border-slate-300 h-14 flex items-center justify-between px-8 z-20 shrink-0">
  <div class="flex items-center">
    <%= link_to root_path, class: "logo-container flex items-center space-x-1 select-none" do %>
      <div class="bg-brand/10 p-1.5 rounded-md mr-2 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand" viewBox="0 0 20 20" fill="currentColor">
          <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" />
        </svg>
      </div>
      <span class="text-xl logo-main">Asset</span>
      <span class="text-xl logo-sub">Binder</span>
    <% end %>
  </div>
  
  <div class="flex items-center space-x-6">
    <div class="flex items-center space-x-4">
      <div class="text-right">
        <p class="text-[12px] font-bold text-slate-800 leading-tight"><%= current_user.name %></p>
        <p class="text-[10px] text-slate-500 tracking-wider font-medium mt-0.5"><%= current_user.role %></p>
      </div>
      <div class="flex items-center justify-center text-slate-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
        </svg>
      </div>
    </div>
    <div class="h-4 w-px bg-slate-300"></div>
    <%= button_to "ログアウト", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "text-slate-500 hover:text-slate-800 font-medium transition text-[12px]" %>
  </div>
</header>