<main class="flex-1 overflow-y-auto bg-white px-10 py-12">
  <div class="max-w-5xl mx-auto">
    <div class="mb-8 border-b border-slate-300 pb-8">
      <h2 class="text-2xl font-bold text-slate-800 tracking-tight">給油記録一覧</h2>
      <p class="text-sm text-slate-500 mt-1">給油データのインポートと履歴の確認ができます</p>
    </div>

    <!-- CSV Import Form -->
    <div class="mb-10 bg-slate-50 p-6 rounded-xl border border-slate-300">
      <h3 class="text-sm font-bold text-slate-700 mb-4 flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        CSVデータインポート
      </h3>
      <%= form_with url: import_fuels_path, multipart: true, local: true, class: "flex items-center gap-4" do |f| %>
        <%= f.file_field :file, accept: ".csv", class: "block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-brand/10 file:text-brand hover:file:bg-brand/20" %>
        <%= f.submit "インポート", class: "bg-brand hover:bg-brand-dark text-white font-bold py-2 px-6 rounded-lg shadow-sm transition cursor-pointer text-sm whitespace-nowrap" %>
      <% end %>
      <p class="text-xs text-slate-400 mt-2">※ ヘッダー行が必要です（管理番号, 給油日時, 金額, 給油量, 単価, 給油所名）</p>
    </div>

    <!-- Fuels List -->
    <div class="border border-slate-300 rounded-xl shadow-sm bg-white">
      <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
        <h3 class="font-bold text-slate-800">給油記録一覧</h3>
      </div>
      <table class="min-w-full divide-y divide-slate-100">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">給油日時</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">管理番号</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">車両</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">給油所</th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">数量(L)</th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">単価(円)</th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">金額(円)</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-slate-100">
          <% if @fuels.any? %>
            <% @fuels.each do |fuel| %>
              <tr class="hover:bg-slate-50">
                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600 font-mono">
                  <%= fuel.filled_at&.strftime('%Y/%m/%d %H:%M') || '-' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-800 font-bold">
                  <%= fuel.card&.internal_id || '-' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">
                  <%= fuel.card&.vehicle&.plate_number || '-' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">
                  <%= fuel.store_name || '-' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600 text-right font-mono">
                  <%= fuel.volume ? number_with_precision(fuel.volume, precision: 2) : '-' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600 text-right font-mono">
                  <%= fuel.unit_price ? number_with_delimiter(fuel.unit_price) : '-' %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-800 text-right font-bold font-mono">
                  <%= fuel.amount ? number_with_delimiter(fuel.amount) : '-' %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="px-6 py-10 text-center text-slate-500 text-sm">
                給油記録はまだありません。CSVファイルをインポートしてください。
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</main>
