<main class="flex-1 overflow-y-auto bg-white px-10 py-12">
  <div class="max-w-5xl mx-auto">
    <div class="mb-8 border-b border-slate-300 pb-8">
      <h2 class="text-2xl font-bold text-slate-800 tracking-tight">レポート</h2>
      <p class="text-sm text-slate-500 mt-1">各種データの集計・分析を行います</p>
    </div>

    <!-- グラフ -->
    <div class="bg-white border border-slate-300 rounded-xl shadow-sm overflow-hidden mb-8 p-6">
      <h3 class="font-bold text-slate-800 mb-4">月別給油金額推移</h3>
      <div class="h-72 w-full" data-controller="chart" data-chart-data-value="<%= @chart_data.to_json %>">
        <canvas data-chart-target="canvas"></canvas>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- 月別推移レポート -->
      <div class="bg-white border border-slate-300 rounded-xl shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
          <h3 class="font-bold text-slate-800">月別コスト推移（直近1年）</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-100">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">年月</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">合計金額</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">給油量</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">平均単価</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-100">
              <% if @monthly_stats.any? %>
                <% @monthly_stats.each do |month, data| %>
                  <tr class="hover:bg-slate-50">
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-slate-700"><%= month %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600 text-right font-mono"><%= number_with_delimiter(data[:amount]) %>円</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600 text-right font-mono"><%= number_with_precision(data[:volume], precision: 1) %>L</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600 text-right font-mono"><%= data[:avg_price] %>円/L</td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="4" class="px-6 py-10 text-center text-slate-500 text-sm">データがありません</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 営業所別レポート -->
      <div class="bg-white border border-slate-300 rounded-xl shadow-sm overflow-hidden h-fit">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
          <h3 class="font-bold text-slate-800">営業所別コスト（直近1年）</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-100">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">営業所名</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">合計金額</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-100">
              <% if @office_stats.any? %>
                <% @office_stats.each do |office_name, amount| %>
                  <tr class="hover:bg-slate-50">
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-slate-700"><%= office_name %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600 text-right font-mono"><%= number_with_delimiter(amount) %>円</td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="2" class="px-6 py-10 text-center text-slate-500 text-sm">データがありません</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 車両別ワーストランキング -->
      <div class="bg-white border border-slate-300 rounded-xl shadow-sm overflow-hidden h-fit lg:col-span-2">
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
          <h3 class="font-bold text-slate-800">車両別給油金額ランキング（ワースト5）</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-100">
            <thead class="bg-slate-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider w-10">順位</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">車両番号</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">所属営業所</th>
                <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">合計金額</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-100">
              <% if @vehicle_ranking.any? %>
                <% @vehicle_ranking.each.with_index(1) do |(vehicle, amount), index| %>
                  <tr class="hover:bg-slate-50">
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-slate-700 text-center"><%= index %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-800 font-bold">
                      <%= link_to "#{vehicle.v_location} #{vehicle.v_code} #{vehicle.v_kana} #{vehicle.v_serial}", vehicle_path(vehicle), class: "hover:text-brand underline decoration-slate-300 underline-offset-2" %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= vehicle.office&.name %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-800 text-right font-mono font-bold"><%= number_with_delimiter(amount) %>円</td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="4" class="px-6 py-10 text-center text-slate-500 text-sm">データがありません</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</main>
