<main class="flex-1 overflow-y-auto bg-white px-10 py-12">
  <div class="max-w-5xl mx-auto">
    <div class="mb-8 border-b border-slate-300 pb-8">
      <h2 class="text-2xl font-bold text-slate-800 tracking-tight">ダッシュボード</h2>
      <p class="text-sm text-slate-500 mt-1">現在の状況とアラートを確認できます</p>
    </div>

    <!-- アラートエリア -->
    <div class="mb-10 space-y-4">
      <% if @alert_vehicles.any? %>
        <div class="bg-red-50 border border-red-200 rounded-xl p-4 flex items-start">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-red-500 mr-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <div>
            <h3 class="text-sm font-bold text-red-800">車検期限が迫っている車両があります (<%= @alert_vehicles.count %>台)</h3>
            <div class="mt-2 text-sm text-red-700">
              <ul class="list-disc list-inside space-y-1">
                <% @alert_vehicles.first(3).each do |vehicle| %>
                  <li>
                    <%= link_to "#{vehicle.v_location} #{vehicle.v_code} #{vehicle.v_kana} #{vehicle.v_serial}", inspection_path(vehicle), class: "underline hover:text-red-900" %>
                    <span class="text-xs ml-2">(期限: <%= vehicle.inspection_expiration_date.strftime('%Y/%m/%d') %>)</span>
                  </li>
                <% end %>
                <% if @alert_vehicles.count > 3 %>
                  <li class="list-none text-xs pt-1">...他 <%= @alert_vehicles.count - 3 %>台</li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% else %>
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-400 mr-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <h3 class="text-sm font-bold text-slate-700">車検期限が近い車両はありません</h3>
          </div>
        </div>
      <% end %>

      <% if @requesting_cards.any? %>
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 flex items-start">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-amber-500 mr-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
          </svg>
          <div>
            <h3 class="text-sm font-bold text-amber-800">受領待ちのカードがあります (<%= @requesting_cards.count %>枚)</h3>
            <div class="mt-2 text-sm text-amber-700">
              <p class="mb-2">カードが手元に届いたら受領処理を行ってください。</p>
              <ul class="list-disc list-inside space-y-1">
                <% @requesting_cards.first(3).each do |card| %>
                  <li>
                    <%= link_to "管理番号: #{card.internal_id}", card_path(card), class: "underline hover:text-amber-900" %>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% else %>
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-400 mr-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <h3 class="text-sm font-bold text-slate-700">受領待ちのカードはありません</h3>
          </div>
        </div>
      <% end %>
    </div>

    <!-- クイックアクション -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
      <%= link_to new_vehicle_path, class: "flex items-center justify-center px-4 py-3 bg-brand hover:bg-brand-dark text-white rounded-xl shadow-md transition" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <span class="font-bold">車両を追加</span>
      <% end %>

      <%= link_to new_card_path, class: "flex items-center justify-center px-4 py-3 bg-brand hover:bg-brand-dark text-white rounded-xl shadow-md transition" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <span class="font-bold">給油カードを追加</span>
      <% end %>

      <%= link_to new_fuel_path, class: "flex items-center justify-center px-4 py-3 bg-brand hover:bg-brand-dark text-white rounded-xl shadow-md transition", data: { turbo: false } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <span class="font-bold">給油記録を追加</span>
      <% end %>
    </div>

    <!-- KPIサマリー -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm flex items-center">
        <div class="p-3 rounded-full bg-blue-50 text-blue-600 mr-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-bold text-slate-400 uppercase tracking-wider">今月の給油総額</p>
          <p class="text-3xl font-bold text-slate-800"><%= number_with_delimiter(@current_month_cost) %><span class="text-sm font-normal text-slate-500 ml-1">円</span></p>
        </div>
      </div>

      <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm flex items-center">
        <div class="p-3 rounded-full bg-emerald-50 text-emerald-600 mr-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l2-5h10l2 5M3 10h18M5 10v8h2v-2h10v2h2v-8M7 16a2 2 0 100 4 2 2 0 000-4zm10 0a2 2 0 100 4 2 2 0 000-4z" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-bold text-slate-400 uppercase tracking-wider">登録車両数</p>
          <p class="text-3xl font-bold text-slate-800"><%= number_with_delimiter(@total_vehicles) %><span class="text-sm font-normal text-slate-500 ml-1">台</span></p>
        </div>
      </div>
    </div>
  </div>
</main>
