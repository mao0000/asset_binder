<div class="w-full max-w-md">
  <!-- ロゴ部分: ヘッダーと同じクラスを使用し、サイズを大きく調整 -->
  <div class="flex justify-center mb-8">
    <div class="logo-container flex items-center space-x-2 select-none">
      <div class="bg-brand/10 p-2 rounded-lg mr-2 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-brand" viewBox="0 0 20 20" fill="currentColor">
          <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" />
        </svg>
      </div>
      <span class="text-4xl logo-main">Asset</span>
      <span class="text-4xl logo-sub">Binder</span>
    </div>
  </div>

  <!-- ログインフォーム -->
  <div class="bg-white p-10 rounded-xl shadow-sm border border-slate-200">
    <h2 class="text-center text-lg font-bold text-slate-700 mb-8">ログイン</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6", data: { turbo: false } }) do |f| %>
      <div class="space-y-1">
        <%= f.label :email, "メールアドレス", class: "text-xs font-bold text-slate-500" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-all" %>
      </div>

      <div class="space-y-1">
        <%= f.label :password, "パスワード", class: "text-xs font-bold text-slate-500" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "w-full p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-brand transition-all" %>
      </div>

      <%= f.submit "ログイン", class: "w-full bg-brand hover:bg-brand-dark text-white font-bold py-3 px-4 rounded-lg shadow-md hover:shadow-lg transition-all cursor-pointer" %>
    <% end %>
  </div>
</div>