<main class="flex-1 overflow-y-auto bg-white px-10 py-12">
  <div class="max-w-5xl mx-auto">
    <div class="mb-8 border-b border-slate-300 pb-8">
      <h2 class="text-2xl font-bold text-slate-800 tracking-tight">車検スケジュール</h2>
      <p class="text-sm text-slate-500 mt-1">全車両の車検期限を一覧で確認できます</p>
    </div>

    <div class="flex items-center justify-start space-x-4 mb-6">
      <%= form_with url: inspections_path, method: :get, local: true, data: { turbo: false }, class: "flex items-center space-x-2" do |f| %>
        <%= f.collection_select :office_id, Office.all, :id, :name, { include_blank: "全ての営業所", selected: params[:office_id] }, { class: "py-2 pl-3 pr-8 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand cursor-pointer", onchange: "this.form.submit()" } %>
        <div class="relative">
          <%= f.text_field :query, value: params[:query], placeholder: "車両番号で検索...", class: "pl-10 pr-4 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand w-64" %>
          <button type="submit" class="absolute left-3 top-2.5 text-slate-400 hover:text-brand transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          </button>
        </div>
      <% end %>
    </div>

    <!-- Table -->
    <div class="border border-slate-300 rounded-xl shadow-sm bg-white">
      <table class="min-w-full border-collapse">
        <thead>
          <tr class="text-[11px] font-bold text-slate-500 uppercase tracking-widest bg-slate-50 border-b border-slate-300">
            <th class="py-4 px-6 text-left">車両番号</th>
            <th class="py-4 px-6 text-left">所属</th>
            <th class="py-4 px-6 text-left">次回車検期限</th>
            <th class="py-4 px-6 text-left">残り日数</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% @vehicles.each do |vehicle| %>
            <% 
              next_inspection = vehicle.inspection_expiration_date
              days_remaining = next_inspection ? (next_inspection - Date.today).to_i : nil
              
              # 期限切れや期限間近（2ヶ月以内）のスタイル設定
              row_class = if days_remaining && days_remaining < 0
                            "bg-red-50"
                          elsif days_remaining && days_remaining <= 60
                            "bg-orange-50"
                          else
                            "table-row-hover transition-colors"
                          end
              
              text_color = if days_remaining && days_remaining < 0
                             "text-red-600 font-bold"
                           elsif days_remaining && days_remaining <= 60
                             "text-orange-600 font-bold"
                           else
                             "text-slate-600"
                           end
            %>
            <tr class="<%= row_class %> cursor-pointer" onclick="window.location='<%= inspection_path(vehicle) %>'">
              <td class="py-4 px-6">
                <p class="text-[14px] font-bold text-slate-800"><%= "#{vehicle.v_location} #{vehicle.v_code} #{vehicle.v_kana} #{vehicle.v_serial}" %></p>
              </td>
              <td class="py-4 px-6">
                <p class="text-[13px] text-slate-700"><%= vehicle.office&.name %></p>
              </td>
              <td class="py-4 px-6">
                <p class="text-[13px] <%= text_color %>"><%= next_inspection ? next_inspection.strftime('%Y年%m月%d日') : "未登録" %></p>
              </td>
              <td class="py-4 px-6">
                <% if days_remaining %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold <%= days_remaining < 0 ? 'bg-red-100 text-red-700' : (days_remaining <= 60 ? 'bg-orange-100 text-orange-700' : 'bg-slate-100 text-slate-600') %>">
                    <%= days_remaining < 0 ? "期限切れ (#{days_remaining.abs}日経過)" : "あと #{days_remaining} 日" %>
                  </span>
                <% else %>
                  <span class="text-xs text-slate-400">-</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</main>