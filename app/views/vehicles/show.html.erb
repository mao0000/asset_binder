<main class="flex-1 overflow-y-auto bg-white px-10 py-12">
  <div class="max-w-2xl mx-auto">
    <!-- 戻るボタンとタイトル -->
    <div class="flex items-center justify-between mb-10">
      <div class="flex items-center">
        <%= link_to root_path, class: "mr-4 p-2 rounded-full hover:bg-slate-100 text-slate-400 hover:text-slate-800 transition" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        <% end %>
        <h2 class="text-2xl font-bold text-slate-800 tracking-tight">車両詳細</h2>
      </div>
      
      <!-- アクションボタン -->
      <div class="flex space-x-3">
        <%= link_to edit_vehicle_path(@vehicle), class: "flex items-center px-4 py-2 bg-white border border-slate-200 rounded-lg text-sm font-bold text-slate-600 hover:bg-slate-50 hover:text-brand transition shadow-sm" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          編集
        <% end %>
        <%= form_with url: vehicle_path(@vehicle), method: :delete, local: true, data: { turbo: false } do |f| %>
          <%= f.button class: "flex items-center px-4 py-2 bg-white border border-red-200 rounded-lg text-sm font-bold text-red-600 hover:bg-red-50 transition shadow-sm" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            削除
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- 詳細カード -->
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
      <!-- ヘッダー部分 -->
      <div class="bg-slate-50 px-8 py-6 border-b border-slate-200 flex justify-between items-center">
        <div>
          <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">車両番号</p>
          <h3 class="text-2xl font-bold text-slate-800"><%= "#{@vehicle.v_location} #{@vehicle.v_code} #{@vehicle.v_kana} #{@vehicle.v_serial}" %></h3>
        </div>
        <!-- ステータスバッジ -->
        <% 
          status_style = case @vehicle.status_id
            when 1 then "bg-brand/5 text-brand border-brand/20"
            else "bg-slate-100 text-slate-600 border-slate-200"
          end
        %>
        <span class="inline-flex items-center px-3 py-1 rounded border text-sm font-semibold <%= status_style %>">
          <%= @vehicle.status&.name %>
        </span>
      </div>

      <!-- 詳細リスト -->
      <div class="p-8">
        <dl class="grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-2">
          <div class="sm:col-span-1">
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">所属営業所</dt>
            <dd class="text-sm font-semibold text-slate-800 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
              <%= @vehicle.office&.name %>
            </dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">車載器管理番号</dt>
            <dd class="text-sm font-mono font-medium text-slate-800 bg-slate-50 px-3 py-2 rounded border border-slate-100 inline-block">
              <%= @vehicle.formatted_obe_number || "未登録" %>
            </dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">登録者</dt>
            <dd class="text-sm text-slate-600 flex items-center">
              <div class="w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center text-[10px] font-bold text-slate-500 mr-2">
                <%= @vehicle.user.name.first %>
              </div>
              <%= @vehicle.user.name %>
            </dd>
          </div>
          <div class="sm:col-span-1">
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">登録日時</dt>
            <dd class="text-sm text-slate-600">
              <%= @vehicle.created_at.strftime("%Y年%m月%d日 %H:%M") %>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</main>