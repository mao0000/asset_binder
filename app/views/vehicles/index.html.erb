<main class="flex-1 overflow-y-auto bg-white px-10 py-12">
  <div class="max-w-5xl mx-auto">
    <div class="mb-8 border-b border-slate-300 pb-8">
      <h2 class="text-2xl font-bold text-slate-800 tracking-tight">車両管理</h2>
      <p class="text-sm text-slate-500 mt-1">登録されている車両データを管理します</p>
    </div>

    <div class="flex items-center justify-between mb-6">
        
        <!-- 検索・絞り込み -->
        <div>
          <%= form_with url: vehicles_path, method: :get, local: true, data: { turbo: false }, class: "flex items-center space-x-2" do |f| %>
            <%= f.collection_select :office_id, Office.all, :id, :name, { include_blank: "全ての営業所", selected: params[:office_id] }, { class: "py-2 pl-3 pr-8 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand cursor-pointer", onchange: "this.form.submit()" } %>
            <div class="relative">
              <%= f.text_field :query, value: params[:query], placeholder: "車両番号で検索...", class: "pl-10 pr-4 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand w-64" %>
              <button type="submit" class="absolute left-3 top-2.5 text-slate-400 hover:text-brand transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
              </button>
            </div>
          <% end %>
        </div>

        <!-- 新規登録ボタン -->
        <%= link_to new_vehicle_path, class: "flex items-center px-4 py-2 bg-brand hover:bg-brand-dark text-white rounded-lg text-sm font-bold shadow-md transition" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          車両を追加
        <% end %>
    </div>

    <!-- Table -->
    <div class="border border-slate-300 rounded-xl shadow-sm bg-white">
      <table class="min-w-full border-collapse">
        <thead>
          <tr class="text-[11px] font-bold text-slate-500 uppercase tracking-widest bg-slate-50 border-b border-slate-300">
            <th class="py-4 px-6 text-left">車両番号</th>
            <th class="py-4 px-6 text-left">所属</th>
            <th class="py-4 px-6 text-left">ステータス</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% if @vehicles.any? %>
            <% @vehicles.each do |vehicle| %>
              <tr class="table-row-hover transition-colors cursor-pointer" onclick="window.location='<%= vehicle_path(vehicle) %>'">
                <td class="py-4 px-6">
                  <p class="text-[14px] font-bold text-slate-800"><%= "#{vehicle.v_location} #{vehicle.v_code} #{vehicle.v_kana} #{vehicle.v_serial}" %></p>
                </td>
                <td class="py-4 px-6">
                  <p class="text-[13px] text-slate-700"><%= vehicle.office&.name %></p>
                </td>
                <td class="py-4 px-6">
                  <% 
                    status_style = case vehicle.status_id
                      when 1 then "bg-brand/5 text-brand border-brand/20"
                      else "bg-slate-100 text-slate-600 border-slate-300"
                    end
                  %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded border text-[13px] font-semibold <%= status_style %>">
                    <%= vehicle.status&.name %>
                  </span>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="3" class="py-10 px-6 text-center text-slate-400 text-sm">
                データはまだありません。
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</main>
