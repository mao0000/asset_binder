<%= form_with model: vehicle, local: true, data: { turbo: false }, class: "space-y-8" do |f| %>
  <% if vehicle.errors.any? %>
    <div class="bg-red-50 text-red-500 p-4 rounded-lg text-sm font-bold text-center">
      入力内容に不備があります。
    </div>
  <% end %>

  <!-- 車両番号 (ハイフンなし) -->
  <div>
    <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-3">車両番号 <span class="text-red-500 ml-1">*</span></label>
    <div class="grid grid-cols-4 gap-4">
      <div class="space-y-1">
        <p class="text-[10px] text-slate-400 ml-1">地域</p>
        <%= f.text_field :v_location, placeholder: "世田谷", class: "w-full p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all" %>
      </div>
      <div class="space-y-1">
        <p class="text-[10px] text-slate-400 ml-1">分類番号</p>
        <%= f.text_field :v_code, placeholder: "500", class: "w-full p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all" %>
      </div>
      <div class="space-y-1">
        <p class="text-[10px] text-slate-400 ml-1">かな</p>
        <%= f.text_field :v_kana, placeholder: "あ", class: "w-full p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all" %>
      </div>
      <div class="space-y-1">
        <p class="text-[10px] text-slate-400 ml-1">一連番号</p>
        <%= f.text_field :v_serial, placeholder: "1234", class: "w-full p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all" %>
      </div>
    </div>
  </div>

  <!-- 初度登録年月 -->
  <div>
    <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-3">初度登録年月</label>
    <div class="flex items-center space-x-4">
      <%
        current_year = Date.today.year
        years = (2000..current_year + 1).map do |y|
          era = if y >= 2019
                  y == 2019 ? "令和元年" : "令和#{y - 2018}年"
                else
                  "平成#{y - 1988}年"
                end
          ["#{era} (#{y}年)", y]
        end.reverse
      %>
      <%= select_tag "vehicle[first_registration_date(1i)]", options_for_select(years, vehicle.first_registration_date&.year), prompt: "年を選択", class: "p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all cursor-pointer" %>
      <%= select_tag "vehicle[first_registration_date(2i)]", options_for_select((1..12).map { |m| ["#{m}月", m] }, vehicle.first_registration_date&.month), prompt: "月を選択", class: "p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all cursor-pointer" %>
      <input type="hidden" name="vehicle[first_registration_date(3i)]" value="1">
    </div>
  </div>

  <!-- 有効期限の満了する日 -->
  <div>
    <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-3">有効期限の満了する日</label>
    <div class="flex items-center space-x-4">
      <%
        # 有効期限は未来の日付も含むため、範囲を現在から10年後まで広げる
        exp_years = (2000..Date.today.year + 10).map do |y|
          era = if y >= 2019
                  y == 2019 ? "令和元年" : "令和#{y - 2018}年"
                else
                  "平成#{y - 1988}年"
                end
          ["#{era} (#{y}年)", y]
        end.reverse
      %>
      <%= select_tag "vehicle[inspection_expiration_date(1i)]", options_for_select(exp_years, vehicle.inspection_expiration_date&.year), prompt: "年を選択", class: "p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all cursor-pointer" %>
      <%= select_tag "vehicle[inspection_expiration_date(2i)]", options_for_select((1..12).map { |m| ["#{m}月", m] }, vehicle.inspection_expiration_date&.month), prompt: "月を選択", class: "p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all cursor-pointer" %>
      <%= select_tag "vehicle[inspection_expiration_date(3i)]", options_for_select((1..31).map { |d| ["#{d}日", d] }, vehicle.inspection_expiration_date&.day), prompt: "日を選択", class: "p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all cursor-pointer" %>
    </div>
  </div>

  <!-- 車両詳細情報 (種別・用途・区分・重量) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
    <div>
      <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-3">自動車の種別</label>
      <div class="relative">
        <%= f.select :vehicle_type, ['普通自動車', '小型自動車', '軽自動車', '大型特殊自動車', '小型特殊自動車'], { prompt: "選択してください" }, class: "w-full p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all cursor-pointer appearance-none" %>
        <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none text-slate-400">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </div>
      </div>
    </div>
    <div>
      <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-3">用途</label>
      <div class="relative">
        <%= f.select :usage, ['貨物', '乗用', '乗合', '特種'], { prompt: "選択してください" }, class: "w-full p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all cursor-pointer appearance-none" %>
        <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none text-slate-400">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </div>
      </div>
    </div>
    <div>
      <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-3">自家用・事業用の別</label>
      <div class="relative">
        <%= f.select :usage_type, ['自家用', '事業用'], { prompt: "選択してください" }, class: "w-full p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all cursor-pointer appearance-none" %>
        <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none text-slate-400">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </div>
      </div>
    </div>
    <div>
      <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-3">車両総重量 (kg)</label>
      <%= f.number_field :gross_weight, placeholder: "2985", class: "w-full p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all" %>
    </div>
  </div>

  <!-- 車載器管理番号 -->
  <div>
    <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-3">車載器管理番号 (5桁-8桁-6桁)</label>
    <div class="flex items-center space-x-2">
      <%= f.text_field :obe_number_part1, placeholder: "12345", maxlength: 5, class: "w-24 p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all text-center" %>
      <span class="text-slate-400 font-bold">-</span>
      <%= f.text_field :obe_number_part2, placeholder: "12345678", maxlength: 8, class: "w-36 p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all text-center" %>
      <span class="text-slate-400 font-bold">-</span>
      <%= f.text_field :obe_number_part3, placeholder: "123456", maxlength: 6, class: "w-32 p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all text-center" %>
    </div>
  </div>

  <!-- 所属情報・ステータス -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
    <div>
      <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-3">所属営業所 <span class="text-red-500 ml-1">*</span></label>
      <div class="relative">
        <%= f.collection_select :office_id, Office.all, :id, :name, { prompt: "営業所を選択してください" }, { class: "w-full p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all appearance-none cursor-pointer" } %>
        <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none text-slate-400">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </div>
      </div>
    </div>
    <div>
      <label class="block text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-3">ステータス <span class="text-red-500 ml-1">*</span></label>
      <div class="relative">
        <%= f.collection_select :status_id, Status.all, :id, :name, { prompt: "ステータスを選択してください" }, { class: "w-full p-3 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:outline-none focus:border-brand transition-all appearance-none cursor-pointer" } %>
        <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none text-slate-400">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </div>
      </div>
    </div>
  </div>

  <!-- ボタンエリア -->
  <div class="pt-10 border-t border-slate-300 flex justify-end items-center space-x-6">
    <%= link_to "キャンセル", (vehicle.new_record? ? root_path : vehicle_path(vehicle)), class: "text-[13px] font-bold text-slate-400 hover:text-slate-600 transition" %>
    <%= f.submit (vehicle.new_record? ? "車両を登録する" : "変更を保存する"), class: "bg-brand hover:bg-brand-dark text-white text-[14px] font-bold py-3 px-10 rounded-lg shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all cursor-pointer" %>
  </div>
<% end %>